{
    "name": "horde/autoloader_cache",
    "description": "Caching library for Horde_Autoloader",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Autoloader_Cache",
    "license": "LGPL-2.1",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "developer"
        }
    ],
    "time": "2026-06-27",
    "repositories": [],
    "require": {
        "php": "^7",
        "horde/autoloader": "^3 || dev-FRAMEWORK_6_0",
        "ext-json": "*"
    },
    "require-dev": {},
    "suggest": {
        "ext-horde_lz4": "*",
        "ext-lzf": "*",
        "ext-msgpack": "*",
        "ext-apc": "*",
        "ext-eaccelerator": "*",
        "ext-xcache": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Autoloader_Cache": "lib/"
        }
    },
    "autoload-dev": {},
    "bin": [
        "bin/horde-autoloader-cache-prune"
    ],
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}